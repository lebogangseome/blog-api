<http:listener-config name="blog-api-httpListenerConfig">
        <http:listener-connection host="${http.host}" port="${http.port}" />
    </http:listener-config>
    <apikit:config name="blog-api-config" api="resource::a0158bd8-5210-4487-89ec-d1dcc92bd101:blog-api:1.0.0:raml:zip:blog-api.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
