	<configuration-properties doc:name="Configuration properties" doc:id="c97872c9-60ab-4ad4-ae0f-6a3d10f3908b" file="${env}.properties" />
	<os:object-store name="Object_store" doc:name="Object store" doc:id="94b0878b-3fad-45bf-b0a2-c89eca39f264" persistent="true"/>
	<api-gateway:autodiscovery apiId="${api.id}" ignoreBasePath="true" doc:name="API Autodiscovery" doc:id="9370ac5d-5593-4687-89b1-f8c6578a6beb" flowRef="blog-api-main" />


