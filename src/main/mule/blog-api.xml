	<flow name="put:\articles\(slug):application\json:blog-api-config">
        <ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="slug">attributes.uriParams.'slug'</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <os:retrieve doc:name="Retrieve" doc:id="9a474965-3709-443a-8ef1-51c862a6a836" key="#[Mule::p('os.articles')]" objectStore="Object_store" target="articles">
			<os:default-value ><![CDATA[#[[]]]]></os:default-value>
		</os:retrieve>
		<ee:transform doc:name="Transform Message" doc:id="033fbd94-7765-42e6-8e1e-f465624cf2d8" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
import mergeWith from dw::core::Objects
var existing = vars.articles default []
var all = if (existing is Array) existing else [existing]
---
all map ((item) ->
        if (((item.Id default item.id) as String) == vars.slug)
    item mergeWith payload
  else
    item
)]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<os:store doc:name="Store" doc:id="8e5b01da-17d2-4fb0-9564-16bc8b40b630" key="#[Mule::p('os.articles')]" objectStore="Object_store"/>
		<tracing:remove-logging-variable doc:name="Remove logging variable" doc:id="6ba3f590-750d-4c14-8bce-3fc4a1407f57" variableName="articles"/>
		<ee:transform doc:name="Transform Message" doc:id="2f6fcbc3-0f1c-4b7d-9cd2-82fcd7f491e1" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var all = payload default []
var match = all filter ((a) -> ((a.Id default a.id) as String) == vars.slug)
---
{
  message: "Article updated successfully",
  data: if (isEmpty(match)) null else match[0]
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" message="put:\articles\(slug):application\json:blog-api-config" />
    </flow>
